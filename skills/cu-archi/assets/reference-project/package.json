{
  "name": "cu-archi-todo-reference",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @cu-archi/api --filter @cu-archi/web run \"/^(dev|storybook)$/\"",
    "dev:api": "pnpm --filter @cu-archi/api dev",
    "dev:web": "pnpm --filter @cu-archi/web dev",
    "storybook": "pnpm --filter @cu-archi/web storybook",
    "prepare": "husky",
    "lint": "eslint .",
    "check": "pnpm -r run check && pnpm check:tests && pnpm check:architecture && pnpm lint",
    "test": "vitest run",
    "build": "pnpm -r --if-present run build",
    "build-storybook": "pnpm --filter @cu-archi/web build-storybook",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,yaml}\"",
    "check:tests": "tsc -p tsconfig.tests.json",
    "check:architecture": "node scripts/check-architecture.mjs"
  },
  "devDependencies": {
    "@cu-archi/core": "workspace:*",
    "@eslint/js": "10.0.1",
    "@storybook/react-vite": "10.6.2",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "better-sqlite3": "13.0.3",
    "eslint": "10.13.0",
    "happy-dom": "21.0.4",
    "husky": "9.1.7",
    "prettier": "3.9.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "storybook": "10.6.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.4",
    "vitest": "4.1.10"
  },
  "type": "module"
}
